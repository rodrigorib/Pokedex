<div class="container mt-5">
    <div class="card text-center shadow p-4">

        @if (Model != null)
        {
            <h2 class="card-title">@Model.Nome</h2>
            <div style="height: 140px;">
                <img src="@Model.UrlImagem" alt="@Model.Nome" class="mx-auto mb-3" style="max-width: 200px;" />
            </div>
        }

        <div class="d-flex justify-content-center gap-3 mb-3">
            <form asp-action="Previous" method="post">
                <button type="submit" class="btn btn-outline-primary">Anterior</button>
            </form>

            <form asp-action="Next" method="post">
                <button type="submit" class="btn btn-outline-primary">Próximo</button>
            </form>
        </div>

        <form asp-action="Index" method="get" class="d-flex justify-content-center gap-2">
            <input type="text" name="filtro" class="form-control w-50" placeholder="ID ou nome do Pokémon" />
            <button type="submit" class="btn btn-success">Buscar</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-4 text-center">
                @ViewBag.Error
            </div>
        }

    </div>
</div>